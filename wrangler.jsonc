{
  // Cloudflare Pages project config.
  //
  // The dashboard already carries the build command and output directory; this
  // file records them in git too, and silences the build-log warning that
  // appears when a Wrangler config exists without `pages_build_output_dir`.
  //
  // Must match `build.sh`'s OUT and the dashboard's "Build output directory".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mobile-gallery-purchase-sheets",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "./_site"

  // If this project is ever recreated through the Workers tab instead of Pages,
  // that flow wants a different shape — replace `pages_build_output_dir` with:
  //
  //   "assets": { "directory": "./_site", "not_found_handling": "none" }
  //
  // See SETUP-HOSTING.md.
}
