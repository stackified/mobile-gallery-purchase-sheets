{
  "id": "/?mobile-gallery",
  "name": "Mobile Gallery — Purchase Sheets",
  "short_name": "Mobile Gallery",
  "description": "Purchase lists and price lists for Mobile Gallery, Surat. Build a sheet, print it on one A4 page, take it to the mandi.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#faf7f0",
  "theme_color": "#204b2f",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New purchase list",
      "short_name": "Purchase",
      "url": "./index.html#buy",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Price list",
      "short_name": "Prices",
      "url": "./index.html#rate",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Master data",
      "short_name": "Master",
      "url": "./index.html#master",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
