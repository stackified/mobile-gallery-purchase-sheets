# Cloudflare Pages header rules.
#
# The auto-update flow depends on two files never being served stale from the
# edge cache. Without these rules Cloudflare would happily cache version.json
# for minutes or hours and the phone would keep reporting "up to date".

# The update probe. Must always come from the origin.
/version.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

# The service worker. A stale worker keeps serving the old app shell.
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Service-Worker-Allowed: /

# The app shell. Revalidate on every load so an update lands on first open;
# the service worker still serves it instantly when offline.
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate

# Icons are content-stable and tiny — cache them hard.
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Baseline hardening. No external requests are made by the app, so the CSP can
# be strict; 'unsafe-inline' is required because the CSS and JS are inline by
# design (the app has to work as a single file from a file:// path too).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
